# Конфигурация для Apache и LiteSpeed. На nginx файл не читается — там те же
# правила задаются в конфиге сервера.

# Демо-ролики: часть хостингов без явного типа отдаёт .mp4 как октет-поток,
# и браузер отказывается его проигрывать.
AddType video/mp4 .mp4
AddType video/webm .webm

# Языковые версии: /az/... и /en/... обслуживаются теми же файлами, что и
# русская. Префикс снимается здесь, а метка языка уходит в SITE_LANG —
# её читает app/i18n.php. Одного комплекта страниц хватает на три языка.
RewriteEngine On
RewriteRule ^(az|en)$        /$1/            [R=301,L]
RewriteRule ^(az|en)/?$      index.php       [E=SITE_LANG:$1,L]
RewriteRule ^(az|en)/(.*/)?$ $2index.php     [E=SITE_LANG:$1,L]
RewriteRule ^(az|en)/(.+)$   $2              [E=SITE_LANG:$1,L]

# Разделы переехали вместе с переименованием: «Работы» -> «Портфолио»,
# «Журнал» -> «Блог». Ссылки и закладки на старые адреса должны жить.
RedirectMatch 301 ^/raboty/?$        /portfolio/
RedirectMatch 301 ^/raboty/(.*)$     /portfolio/$1
RedirectMatch 301 ^/zhurnal/?$       /blog/
RedirectMatch 301 ^/zhurnal/(.*)$    /blog/$1

# Картинки и ролики меняются вместе с именем файла, их можно держать в кеше
# долго. Стили и скрипты — коротко: они версий в имени не имеют.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType video/mp4       "access plus 1 year"
  ExpiresByType text/css        "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
</IfModule>
