# Конфигурация для Apache и LiteSpeed. На nginx файл не читается — там те же
# правила задаются в конфиге сервера.

# Демо-ролики: часть хостингов без явного типа отдаёт .mp4 как октет-поток,
# и браузер отказывается его проигрывать.
AddType video/mp4 .mp4
AddType video/webm .webm
# Уменьшенные копии картинок (tools/make-images.php): по типу им ставится
# срок кеша ниже, а с октет-потоком ExpiresByType не сработал бы.
AddType image/webp .webp

# ---------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ

# Листинг каталогов. На боевом домене он был включён: пустой public_html
# отдавал «Index of /». Любая папка без index.php показывала бы содержимое.
Options -Indexes

# Второй слой защиты точечных файлов: срабатывает, даже если mod_rewrite
# выключат. Сам по себе НЕ закрывает точечные папки — FilesMatch смотрит
# только на последний сегмент имени, и для /.git/config это «config».
# Настоящая защита — правило по пути ниже, сразу после RewriteEngine On.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Год на HTTPS. Браузер, однажды увидевший этот заголовок, больше не ходит
  # на сайт по http вовсе — даже по ссылке и даже до редиректа. Это закрывает
  # окно, в котором первый запрос идёт открытым текстом и его можно перехватить.
  #
  # Включать только когда HTTPS работает на всём сайте: отключить обратно
  # нельзя, браузер будет помнить запрет весь срок.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Точная версия PHP в заголовке — подсказка тому, кто ищет сервер
  # с известной уязвимостью. Убираем; то же делает app/bootstrap.php.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Браузер не должен угадывать тип файла: загруженная картинка, которую
  # он решит считать скриптом, — это выполнение чужого кода на нашем домене.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Политика содержимого. script-src без 'unsafe-inline' — на сайте
  # ноль инлайновых скриптов и ноль обработчиков в атрибутах, проверено.
  # Для стилей послабление нужно: в разметке 110 атрибутов style.
  # frame-ancestors 'none' заменяет X-Frame-Options.
  #
  # ЗНАЧЕНИЕ ОБЯЗАНО СОВПАДАТЬ С КОНСТАНТОЙ CSP_POLICY В app/security.php.
  # Правится здесь: заголовок из PHP до браузера не доезжает, его перебивает
  # эта строка. Если строки разойдутся, под mod_php браузер получит две разные
  # политики и применит самую строгую — сломается то, что разрешено одной из них.
  # Раздел «Безопасность» в панели сверяет их и показывает расхождение.
  #
  # challenges.cloudflare.com нужен капче Turnstile: script-src для api.js,
  # frame-src для окна проверки, connect-src страховкой. 'unsafe-inline' для
  # скриптов по-прежнему НЕ нужен — виджет рисуется без встроенного скрипта.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>
# ---------------------------------------------------------------------------

# Всё, что отдаётся не с боевого домена — тестовый поддомен, временный адрес
# хостинга — закрыто от индексации. Иначе у сайта появляется копия, и две
# версии начинают конкурировать в выдаче за одни и те же запросы.
# На самом mguliyev.com правило не срабатывает: заголовок не выставляется.
<IfModule mod_headers.c>
  SetEnvIfNoCase Host ^(www\.)?mguliyev\.com$ LIVE_HOST=1
  Header set X-Robots-Tag "noindex, nofollow" env=!LIVE_HOST
</IfModule>

RewriteEngine On

# Любой сегмент пути, начинающийся с точки. FilesMatch для этого не годится:
# он смотрит только на последний сегмент, и /.git/config для него — файл
# «config», без точки. Стоит до всех остальных правил, иначе /az/.git/config
# уйдёт в языковое и проверку обойдёт. Исключение одно — .well-known,
# через него выпускаются сертификаты.
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Служебные файлы: PHP на cPanel кладёт error_log рядом со скриптом,
# а деплой его никогда не уберёт — он только копирует.
RewriteRule (^|/)(error_log|php_errorlog)$ - [F,L]
RewriteRule \.(ya?ml|sql|bak|dist|inc|log|sh|swp|orig|rej)$ - [F,L]

# Всё, что ниже, написано правилами mod_rewrite, в том числе редиректы.
# Смешивать RedirectMatch с RewriteRule в одном файле нельзя: они
# обрабатываются в разных фазах, и порядок строк перестаёт что-либо значить.
# Например /az/glavnaya/ попал бы в правило языков раньше своего редиректа
# и отдал бы 404 вместо перехода на /az/.

# ---------------------------------------------------------------------------
# ПЕРЕНОС СО СТАРОГО САЙТА НА WORDPRESS. Идёт первым блоком.
#
# На старом сайте корень был английским, а переводы жили на /ru/glavnaya/
# и /az/glavnaya/. На новом корень русский — так решено. Поэтому адрес /
# сохраняется, но язык на нём меняется с английского на русский,
# а английская версия переезжает на /en/.
RewriteRule ^ru/glavnaya-2/?$   /            [R=301,L]
RewriteRule ^ru/glavnaya/?$     /            [R=301,L]
RewriteRule ^ru/?$              /            [R=301,L]
RewriteRule ^az/glavnaya/?$     /az/         [R=301,L]
RewriteRule ^about/?$           /en/o-studii/  [R=301,L]
RewriteRule ^contact/?$         /en/kontakty/  [R=301,L]
RewriteRule ^projects/?$        /en/portfolio/ [R=301,L]

# Служебные страницы старого сайта: содержания нет, но они попали в карту
# сайта и могли быть проиндексированы — уводим на главную.
RewriteRule ^(coming|test)/?$   /            [R=301,L]

# Карты сайта Yoast: остаётся один адрес.
RewriteRule ^sitemap_index\.xml$    /sitemap.xml  [R=301,L]
RewriteRule ^[a-z-]+-sitemap\.xml$  /sitemap.xml  [R=301,L]

# Административные адреса WordPress: на новом сайте их нет, и держать их
# открытыми для перебора паролей незачем.
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [G,L]
# ---------------------------------------------------------------------------

# Разделы, переименованные уже на новом сайте: «Работы» -> «Портфолио»,
# «Журнал» -> «Блог». Правило учитывает языковой префикс, поэтому
# /az/raboty/ уходит на /az/portfolio/, а не на русскую версию.
RewriteRule ^(az/|en/)?raboty/?$      /$1portfolio/     [R=301,L]
RewriteRule ^(az/|en/)?raboty/(.+)$   /$1portfolio/$2   [R=301,L]
RewriteRule ^(az/|en/)?zhurnal/?$     /$1blog/          [R=301,L]
RewriteRule ^(az/|en/)?zhurnal/(.+)$  /$1blog/$2        [R=301,L]

# Языковые версии: /az/... и /en/... обслуживаются теми же файлами, что и
# русская. Префикс снимается здесь, а метка языка уходит в SITE_LANG —
# её читает app/i18n.php. Одного комплекта страниц хватает на три языка.
# Панель — вне языков. Без этого правила /az/admin/ открывал её точку
# входа, но cookie сессии выдана для пути /admin/ и туда не приходит:
# вошедшему редактору показывалась форма входа, будто его выкинуло.
# Приучать человека вводить пароль заново по присланной ссылке — это
# заготовка под выуживание пароля на похожем адресе.
RewriteRule ^(az|en)/admin(/|$) - [R=404,L]

# Портфолио: у отрасли и у проекта свой адрес.
#   /portfolio/logistika/           -> portfolio/index.php
#   /portfolio/logistika/itas-az/   -> portfolio/project.php
# Правила стоят ДО языковых: иначе /az/portfolio/logistika/ языковое
# правило превратило бы в несуществующий portfolio/logistika/index.php.
# Шаблон сам разбирает путь, параметров в адрес не передаём — так одну
# страницу нельзя открыть под чужим адресом хвостом ?c=….
# Без завершающей косой — постоянный редирект на адрес с ней: две записи
# одного адреса поисковик считает двумя страницами.
RewriteRule ^((?:az|en)/)?portfolio/([a-z0-9-]+)$                /$1portfolio/$2/     [R=301,L]
RewriteRule ^((?:az|en)/)?portfolio/([a-z0-9-]+)/([a-z0-9-]+)$   /$1portfolio/$2/$3/  [R=301,L]
RewriteRule ^(az|en)/portfolio/[a-z0-9-]+/[a-z0-9-]+/$  portfolio/project.php  [E=SITE_LANG:$1,L]
RewriteRule ^portfolio/[a-z0-9-]+/[a-z0-9-]+/$          portfolio/project.php  [L]
RewriteRule ^(az|en)/portfolio/[a-z0-9-]+/$             portfolio/index.php    [E=SITE_LANG:$1,L]
RewriteRule ^portfolio/[a-z0-9-]+/$                     portfolio/index.php    [L]

# Карта сайта собирается из данных: проектов и отраслей больше полутора
# сотен адресов на трёх языках, и вручную она отставала бы от сайта.
RewriteRule ^sitemap\.xml$  sitemap.php  [L]

# Раздел на другом языке без завершающей косой: /en/portfolio -> /en/portfolio/.
# Без этого правила адрес переписывался в каталог portfolio без косой, и
# сервер сам добавлял её — но к уже переписанному адресу, без /en/:
# человек попадал на русскую страницу. Только адреса из латиницы, цифр и
# дефисов, то есть адреса страниц: у файлов в имени есть точка.
RewriteRule ^(az|en)/([a-z0-9-]+(?:/[a-z0-9-]+)*)$  /$1/$2/  [R=301,L]

# [L] здесь не последний шаг: переписанный адрес снова проходит правила,
# и у /az/az/tseny/ снимаются оба префикса: открывалась бы страница-дубль.
# Такой адрес уводит на чистый app/bootstrap.php. [END] остановил бы повтор,
# но его поддержку на LiteSpeed хостинга никто не проверял.
RewriteRule ^(az|en)$        /$1/            [R=301,L]
RewriteRule ^(az|en)/?$      index.php       [E=SITE_LANG:$1,L]
RewriteRule ^(az|en)/(.*/)?$ $2index.php     [E=SITE_LANG:$1,L]
RewriteRule ^(az|en)/(.+)$   $2              [E=SITE_LANG:$1,L]

# Картинки и ролики меняются вместе с именем файла, их можно держать в кеше
# долго. Стили и скрипты — тоже: в адресе у них версия по времени файла
# (asset_url() в app/content.php), и после выкладки адрес другой. Раньше
# версии не было, срок стоял день, и край Cloudflare каждый день ходил
# за ними на сервер. Адрес без версии на год ставить нельзя: правка стилей
# не дошла бы до тех, у кого старая копия.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/webp      "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType video/mp4       "access plus 1 year"
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
