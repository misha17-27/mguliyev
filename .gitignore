# Исходники съёмок клиентских сайтов — 127 МБ рабочих материалов.
# В репозиторий и на хостинг не идут.
/_source/

# Системное
.DS_Store
Thumbs.db
desktop.ini
*.log

# Редакторы
.idea/
.vscode/
*.swp
*~

# Правки из панели управления. На боевом сервере эта папка живёт в ~/site-data,
# вне деплоя; локально — здесь. В репозиторий не попадает: это данные
# заказчика, а не код, и у разработчика с сервером они расходятся.
/site-data/

# Временные копии репозитория для параллельной работы агентов
/.claude/worktrees/
